{
  "name": "@slatico/react-native",
  "version": "0.1.0",
  "private": true,
  "description": "Official React Native SVG icon components for Slatico across all 7 styles with individual icon tree-shaking",
  "keywords": [
    "slatico",
    "icons",
    "react-native",
    "expo",
    "react-native-svg",
    "mobile"
  ],
  "homepage": "https://github.com/infitusofficial/slatico",
  "bugs": {
    "url": "https://github.com/infitusofficial/slatico/issues"
  },
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/react-native"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "react-native": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "react-native": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native-svg": ">=13.0.0"
  },
  "dependencies": {
    "@slatico/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/icons/*.tsx --format esm,cjs --dts --clean --external react --external react-native --external react-native-svg",
    "typecheck": "tsc --noEmit"
  }
}
