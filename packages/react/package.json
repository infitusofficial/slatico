{
  "name": "@slatico/react",
  "version": "0.1.0",
  "description": "Official React icon components for Slatico with full support for all 7 styles and individual icon tree-shaking",
  "keywords": [
    "slatico",
    "icons",
    "react",
    "nextjs",
    "svg",
    "duotone",
    "design-system"
  ],
  "homepage": "https://slatico.dev",
  "bugs": {
    "url": "https://github.com/infitusofficial/slatico/issues"
  },
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@slatico/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/icons/*.tsx --format esm,cjs --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  }
}
