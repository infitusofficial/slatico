{
  "name": "@slatico/core",
  "version": "0.1.0",
  "private": true,
  "description": "Core metadata, types, style specifications, and icon catalog for Slatico",
  "keywords": [
    "slatico",
    "icons",
    "svg",
    "design-system",
    "icon-catalog",
    "typescript"
  ],
  "homepage": "https://github.com/infitusofficial/slatico",
  "bugs": {
    "url": "https://github.com/infitusofficial/slatico/issues"
  },
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  }
}
