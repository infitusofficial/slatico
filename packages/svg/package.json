{
  "name": "@slatico/svg",
  "version": "0.1.0",
  "private": true,
  "description": "Optimized raw SVG files, variant SVG sprites, and programmatic SVG helpers for Slatico icons across all 7 styles",
  "keywords": [
    "slatico",
    "icons",
    "svg",
    "svg-sprite",
    "duotone",
    "design-system"
  ],
  "homepage": "https://github.com/infitusofficial/slatico",
  "bugs": {
    "url": "https://github.com/infitusofficial/slatico/issues"
  },
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/svg"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": "./dist/icons/*",
    "./sprites/*": "./dist/sprites/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@slatico/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean && tsx ../../scripts/build-svg-assets.ts",
    "typecheck": "tsc --noEmit"
  }
}
