{
  "name": "@slatico/web",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight, framework-independent native Custom Elements (<slatico-icon>) for Slatico across all 7 styles",
  "keywords": [
    "slatico",
    "icons",
    "web-components",
    "custom-elements",
    "shadow-dom",
    "svg"
  ],
  "homepage": "https://github.com/infitusofficial/slatico",
  "bugs": {
    "url": "https://github.com/infitusofficial/slatico/issues"
  },
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/web"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@slatico/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/icons/*.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  }
}
