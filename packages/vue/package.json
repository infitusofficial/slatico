{
  "name": "@slatico/vue",
  "version": "0.1.0",
  "private": true,
  "description": "Official Vue 3 icon components for Slatico with full support for all 7 styles, SSR, and individual icon tree-shaking",
  "license": "MIT",
  "author": "Infitus Creative Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/infitusofficial/slatico.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./icons/*": {
      "import": {
        "types": "./dist/icons/*.d.ts",
        "default": "./dist/icons/*.js"
      },
      "require": {
        "types": "./dist/icons/*.d.cts",
        "default": "./dist/icons/*.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "dependencies": {
    "@slatico/core": "workspace:*"
  },
  "scripts": {
    "build": "tsup src/index.ts src/icons/*.ts --format esm,cjs --dts --clean --external vue",
    "typecheck": "tsc --noEmit"
  }
}
