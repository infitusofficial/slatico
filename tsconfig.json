{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": {
      "@slatico/core": ["./packages/core/src/index.ts"],
      "@slatico/svg": ["./packages/svg/src/index.ts"],
      "@slatico/react": ["./packages/react/src/index.ts"],
      "@slatico/vue": ["./packages/vue/src/index.ts"],
      "@slatico/web": ["./packages/web/src/index.ts"],
      "@slatico/font": ["./packages/font/src/index.ts"],
      "@slatico/react-native": ["./packages/react-native/src/index.ts"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "packages/core/src/**/*.ts",
    "packages/svg/src/**/*.ts",
    "packages/react/src/**/*.ts",
    "packages/react/src/**/*.tsx",
    "packages/vue/src/**/*.ts",
    "packages/web/src/**/*.ts",
    "packages/font/src/**/*.ts",
    "packages/react-native/src/**/*.ts",
    "packages/react-native/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "**/dist", "**/.next", "**/out"]
}
